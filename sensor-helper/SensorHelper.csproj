<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>sensor-helper</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <TieredPGO>false</TieredPGO>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.*" />
  </ItemGroup>
  <!-- Drop Linux-only files that ship with the library. -->
  <Target Name="TrimLinuxFiles" AfterTargets="Publish">
    <ItemGroup>
      <_Junk Include="$(PublishDir)libMonoPosixHelper.dll;$(PublishDir)MonoPosixHelper.dll;$(PublishDir)Mono.Posix.NETStandard.dll;$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_Junk)" />
  </Target>
</Project>
